# Dependencies
node_modules/

# Environment variables (NEVER commit real secrets)
.env
.env.local
.env.development
.env.production

# Keep example templates — these ARE committed
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Build output
dist/
build/

# Vite config cache (auto-generated, safe to delete)
vite.config.js.timestamp-*

# Drizzle migrations (generated)
drizzle/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local change log — agent memory, not for Git
CHANGELOG.md

# Agent customizations — local only, not for Git
.agents/
