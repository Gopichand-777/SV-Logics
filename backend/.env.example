# Backend Environment Variables — SV Logics
# ─────────────────────────────────────────────────────────────────────────────
# For local development : copy this file to .env.development and fill values
# For production        : copy this file to .env.production and fill values
# NEVER commit files with real secrets — both are gitignored.

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=
NODE_ENV=

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── AUTH ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING
JWT_EXPIRES_IN=7d

# ── CORS — Frontend URLs ──────────────────────────────────────────────────────
FRONTEND_URL=
ADMIN_URL=

# ── SWAGGER — Backend public URL ──────────────────────────────────────────────
BACKEND_URL=

# ── LOGGING ───────────────────────────────────────────────────────────────────
# dev: 'debug'  |  prod: 'info'
LOG_LEVEL=

# ── PAYMENT GATEWAY ───────────────────────────────────────────────────────────
# Options: mock | razorpay | stripe | cashfree
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── CLOUDFLARE R2 (Object Storage) ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── SENTRY (Error Monitoring) ─────────────────────────────────────────────────
SENTRY_DSN=

# ── GOOGLE OAUTH ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
