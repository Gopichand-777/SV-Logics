# Backend Environment Variables — SV Logics
# Copy this file to .env and fill in your values

# ── SERVER ────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── DATABASE ──────────────────────────────────────────
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/svlogics

# ── AUTH ──────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING
JWT_EXPIRES_IN=7d

# ── GOOGLE OAUTH (fill after Google Cloud setup) ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── PAYMENT ───────────────────────────────────────────
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# ── S3 (fill when ready) ──────────────────────────────
VIDEO_MODE=external_url
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── FRONTEND URLS ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
